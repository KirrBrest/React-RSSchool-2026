{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/(shell)/layout,_N_T_/[locale]/(shell)/page,_N_T_/ru"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale/!KHNoZWxsKQ/__PAGE__",
    "/$d$locale/!KHNoZWxsKQ",
    "/$d$locale",
    "/_index",
    "/_head"
  ]
}